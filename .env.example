# Copy to .env.local for local dev (`npm run dev`/`npm run build` read it automatically).
# See C:\Users\USER\nicu-tools\neoref\README.md for how to obtain these. The deployed
# values are Cloudflare Workers Builds build variables (STATUS.md).

VITE_GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
VITE_GAS_URL=https://script.google.com/macros/s/your-deployment-id/exec
